# Salin ke .env lalu ganti SEMUA nilai CHANGE_ME. Jangan commit .env.
DOMAIN=cmms.example.com
POSTGRES_DB=maintainhub
POSTGRES_USER=maintainhub_owner
POSTGRES_PASSWORD=CHANGE_ME_long_random
APP_DB_PASSWORD=CHANGE_ME_long_random        # password role maintainhub_app (tunduk RLS)
AUTH_DB_PASSWORD=CHANGE_ME_long_random       # role maintainhub_auth (hanya untuk login)
JWT_ACCESS_SECRET=CHANGE_ME_64_hex
JWT_REFRESH_SECRET=CHANGE_ME_64_hex
MFA_ENC_KEY=CHANGE_ME_32_bytes_base64        # enkripsi secret MFA di level aplikasi
S3_ENDPOINT=http://minio:9000
S3_BUCKET=maintainhub
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=                                # verifikasi tanda tangan webhook (X-Hub-Signature-256)
WA_VERIFY_TOKEN=CHANGE_ME

# Asisten AI (opsional). Tanpa kunci, asisten hanya menampilkan hasil pencarian basis pengetahuan.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_PER_HOUR=60                            # batas pertanyaan per pengguna per jam

# Laporan otomatis via email (opsional). Tanpa SMTP_HOST, unduh PDF tetap jalan tetapi kirim email & jadwal nonaktif.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                             # false = STARTTLS (port 587); true = TLS langsung (port 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MaintHub <laporan@perusahaan.com>"
REPORTS_SCHEDULER=on                          # off = matikan penjadwal (mis. pada instance cadangan)
